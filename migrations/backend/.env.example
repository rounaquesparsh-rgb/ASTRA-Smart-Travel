# Backend environment example (DO NOT commit real secrets)
PORT=4000

# Postgres connection string. Example local:
# postgres://username:password@localhost:5432/dbname
DATABASE_URL=postgres://postgres:password@localhost:5432/astra

# Random secret for signing JWTs (change in production)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Google OAuth credentials (create in Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# For local testing:
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Cloudinary (for Photo Bucket)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# LibreTranslate proxy (optional)
LIBRE_URL=https://libretranslate.de/translate

# Frontend URL (used for redirect after OAuth)
FRONTEND_URL=http://localhost:5173
